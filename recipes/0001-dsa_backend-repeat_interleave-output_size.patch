From ffd32f49c27093fbab7362d034e8fb1a1948be48 Mon Sep 17 00:00:00 2001
From: Zhihao Ouyang <oyzh888@users.noreply.github.com>
Date: Fri, 6 Nov 2026 10:35:09 -0800
Subject: [PATCH] dsa_backend: pass output_size to repeat_interleave in
 extend/draft-extend metadata

Profiling GLM-5.3-Flash on 8xH200 (64 agent sessions) showed these two
repeat_interleave calls reading the repeats total back from the device on
every prefill step (~0.95 s of host stall per 2 s window), which starves the
GPU of queued work. The total is already on the host (extend_seq_lens_cpu).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 python/sglang/srt/layers/attention/dsa_backend.py | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/python/sglang/srt/layers/attention/dsa_backend.py b/python/sglang/srt/layers/attention/dsa_backend.py
index c23d000ee0..7225e45308 100644
--- a/python/sglang/srt/layers/attention/dsa_backend.py
+++ b/python/sglang/srt/layers/attention/dsa_backend.py
@@ -1277,8 +1277,13 @@ class DeepseekSparseAttnBackend(
                 # DRAFT_EXTEND: the draft worker extends by (num_correct_drafts + 1)
                 # per request after verification. Lengths vary per request based on
                 # how many tokens were accepted.
+                # output_size from the host mirror: without it repeat_interleave
+                # reads the tensor total back with a device sync every step.
                 page_table = torch.repeat_interleave(
-                    page_table, repeats=forward_batch.extend_seq_lens, dim=0
+                    page_table,
+                    repeats=forward_batch.extend_seq_lens,
+                    dim=0,
+                    output_size=sum(extend_seq_lens_cpu),
                 )
         elif forward_batch.forward_mode.is_extend():
             assert (
@@ -1386,9 +1391,11 @@ class DeepseekSparseAttnBackend(
                     )
 
             if topk_transform_method == TopkTransformMethod.RAGGED:
+                # Same host-known total as above; avoids a per-prefill device sync.
                 topk_indices_offset = torch.repeat_interleave(
                     cu_seqlens_k[:-1],
                     extend_seq_lens,
+                    output_size=sum(extend_seq_lens_cpu),
                 )
         else:
             assert False, f"Unsupported {forward_batch.forward_mode = }"
-- 
